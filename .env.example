# ---- Dashboard ----
# Password for the web dashboard / API. CHANGE THIS.
DASHBOARD_TOKEN=change-me-to-a-long-random-string
# 127.0.0.1 = only this computer can open the dashboard (recommended).
# For phone access use a tunnel (e.g. Cloudflare Tunnel / Tailscale) instead of 0.0.0.0.
HOST=127.0.0.1
PORT=8000
DB_PATH=sniperbot.db

# ---- Trading mode ----
# paper = simulated trades with fake money (default, safe)
# live  = real swaps through Jupiter using the wallet below
MODE=paper

# ---- Live trading only (leave blank for paper) ----
# Base58 private key of a DEDICATED hot wallet. Never use your main wallet.
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional Jupiter API key (https://portal.jup.ag). Blank = free lite endpoint.
JUPITER_API_KEY=
# Live-trading interlocks - ALL are required before MODE=live will start:
#   LIVE_TRADING_CONFIRM must be exactly I_ACCEPT_REAL_FUNDS_RISK
#   hard SOL caps that the dashboard cannot raise
LIVE_TRADING_CONFIRM=
LIVE_MAX_TRADE_SOL=0
LIVE_MAX_DEPLOYED_SOL=0

# ---- Monitoring ----
# Optional dead-man's switch: the bot GETs this URL every minute while healthy.
# Create a free check at healthchecks.io and it alerts you if the bot stops pinging.
HEARTBEAT_URL=

# ---- Notifications (all optional; fill any you want) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# ntfy.sh: install the ntfy app on your phone and subscribe to this topic
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
