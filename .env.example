# ---- Dashboard ----
# Password for the web dashboard / API. CHANGE THIS.
DASHBOARD_TOKEN=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=8000
DB_PATH=sniperbot.db

# ---- Trading mode ----
# paper = simulated trades with fake money (default, safe)
# live  = real swaps through Jupiter using the wallet below
MODE=paper

# ---- Live trading only (leave blank for paper) ----
# Base58 private key of a DEDICATED hot wallet. Never use your main wallet.
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional Jupiter API key (https://portal.jup.ag). Blank = free lite endpoint.
JUPITER_API_KEY=

# ---- Notifications (all optional; fill any you want) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# ntfy.sh: install the ntfy app on your phone and subscribe to this topic
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
